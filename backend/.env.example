
NODE_ENV=development
PORT=3000

# Local PostgreSQL running through Docker Compose.
# "db" is the hostname inside Docker. If you run the backend directly on your
# machine (outside Docker), use localhost instead of db.
DATABASE_URL=postgresql://app_user:dev_password@db:5432/app_db

# Maximum connections in the application's local pg pool
DB_POOL_MAX=10

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Why no .env.development?
# Environment variables are configured in the docker compose file

# Why No .env.production?
# For production, we will put environment variables directly in the
# Vercel project's environment variables settings