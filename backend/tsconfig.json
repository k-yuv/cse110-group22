{
  "compilerOptions": {
    // Type-check only. tsx runs the code, so nothing is compiled to disk.
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023"],
    // Files are CommonJS (package.json has no "type": "module"), so relative
    // imports don't need file extensions.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vitest.config.mts"]
}
